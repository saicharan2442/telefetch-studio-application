# --- TeleFetch Studio configuration (copy to .env; never commit real values) ---

# PostgreSQL connection used for settings, channels, queue, history and dedup records.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Telegram API credentials for YOUR application, from https://my.telegram.org → "API development tools".
# These identify the app, not your account. They are read server-side only, never logged and never stored in the DB.
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Optional: override where the local session file + app data are kept (default: per-user app data dir).
# XDG_DATA_HOME=/path/to/data      (Linux/macOS)      LOCALAPPDATA is used on Windows automatically.
