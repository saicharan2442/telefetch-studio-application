{
  "name": "nextjs-postgresql-template",
  "version": "1.0.0",
  "description": "TeleFetch Studio Application",
  "author": "TeleFetch",
  "private": true,
  "main": "electron-main.js",
  "scripts": {
    "electron": "electron .",
    "electron:dev": "electron .",
    "electron:build": "electron-builder -w",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "dotenv": "17.3.1",
    "next": "16.2.6",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "telegram": "^2.26.22",
    "vitest": "^5.0.1"
  },
  "build": {
    "appId": "com.telefetchstudio.app",
    "productName": "TeleFetch Studio",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "package.json",
      ".next/**/*",
      "electron-main.js",
      ".env",
      "public/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "public/favicon.ico"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "get-port": "^7.2.0",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
